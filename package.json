{
  "name": "connextion-app",
  "version": "1.0.0",
  "description": "Application Electron de commande et livraison de repas",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Key-Neil",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"webpack serve --config webpack.renderer.config.js\" \"wait-on http://localhost:8080 && electron .\"",
    "build": "webpack --config webpack.main.config.js && webpack --config webpack.renderer.config.js",
    "start": "electron dist/main/index.js",
    "package": "npm run build && electron-builder",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx,json,css}"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.0",
    "dotenv": "^16.3.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "prisma": "^5.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.0.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
