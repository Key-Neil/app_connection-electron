// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TABLES - Modèles de la base de données
// ============================================================

model Utilisateur {
  id_utilisateur     Int                  @id @default(autoincrement())
  nom                String?              @db.VarChar(50)
  prenom             String               @db.VarChar(50)
  email              String               @unique @db.VarChar(100)
  mot_de_passe_hash  String               @db.VarChar(255)
  
  utilisateur_roles  UtilisateurRole[]
  staff_restaurants  StaffRestaurant[]
  commandes          Commande[]           @relation("ClientCommandes")
  livraisons         Livraison[]          @relation("LivreurLivraisons")

  @@map("Utilisateurs")
}

model Role {
  id_role           Int                  @id @default(autoincrement())
  nom_role          String               @unique @db.VarChar(50)
  
  utilisateur_roles UtilisateurRole[]

  @@map("Roles")
}

model UtilisateurRole {
  id_utilisateur Int
  id_role        Int
  
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  role           Role        @relation(fields: [id_role], references: [id_role], onDelete: Cascade)

  @@id([id_utilisateur, id_role])
  @@map("Utilisateurs_Roles")
}

model Restaurant {
  id_restaurant     Int                  @id @default(autoincrement())
  nom               String               @db.VarChar(100)
  adresse           String               @db.VarChar(255)
  telephone         String               @db.VarChar(20)
  latitude          Float                @default(48.8566)
  longitude         Float                @default(2.3522)
  
  sections          SectionMenu[]
  produits          Produit[]
  staff_restaurants StaffRestaurant[]
  commandes         Commande[]

  @@map("Restaurants")
}

model StaffRestaurant {
  id_utilisateur Int
  id_restaurant  Int
  
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  restaurant     Restaurant  @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)

  @@id([id_utilisateur, id_restaurant])
  @@map("Staff_Restaurants")
}

model SectionMenu {
  id_section    Int         @id @default(autoincrement())
  nom           String      @db.VarChar(100)
  description   String?     @db.Text
  ordre         Int         @default(0)
  id_restaurant Int
  
  restaurant    Restaurant  @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)
  produits      Produit[]

  @@map("Sections_Menu")
}

model Produit {
  id_produit    Int              @id @default(autoincrement())
  nom           String           @db.VarChar(100)
  prix          Float
  description   String?          @db.Text
  url_photo     String?          @db.VarChar(255)
  prix_promo    Float?
  id_section    Int
  id_restaurant Int
  
  section            SectionMenu       @relation(fields: [id_section], references: [id_section], onDelete: Cascade)
  restaurant         Restaurant        @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)
  details_commande   DetailCommande[]

  @@map("Produits")
}

model Commande {
  id_commande   Int              @id @default(autoincrement())
  date_commande DateTime         @default(now())
  statut        String           @default("En attente") @db.VarChar(50)
  id_client     Int
  id_restaurant Int
  
  client            Utilisateur      @relation("ClientCommandes", fields: [id_client], references: [id_utilisateur], onDelete: Cascade)
  restaurant        Restaurant       @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)
  details_commande  DetailCommande[]
  livraison         Livraison?

  @@map("Commandes")
}

model DetailCommande {
  id_detail      Int      @id @default(autoincrement())
  id_commande    Int
  id_produit     Int
  quantite       Int
  prix_unitaire  Float
  
  commande  Commande @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  produit   Produit  @relation(fields: [id_produit], references: [id_produit], onDelete: Cascade)

  @@map("Details_Commande")
}

model Livraison {
  id_livraison              Int       @id @default(autoincrement())
  id_commande               Int       @unique
  id_livreur                Int
  statut_livraison          String    @default("En attente") @db.VarChar(50)
  heure_acceptation         DateTime?
  heure_livraison_effective DateTime?
  
  commande Commande    @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  livreur  Utilisateur @relation("LivreurLivraisons", fields: [id_livreur], references: [id_utilisateur], onDelete: Cascade)

  @@map("Livraisons")
}
