datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id_role      Int             @id @default(autoincrement())
  nom_role     String          @unique
  utilisateurs EffectuerRole[]
}

model Utilisateur {
  id_utilisateur            Int              @id @default(autoincrement())
  nom                       String
  prenom                    String
  email                     String           @unique
  mot_de_passe_hash         String
  telephone                 String?          @unique
  adresse_livraison_default String?
  disponibilite             String?
  position_lat              Float?
  position_lon              Float?

  roles              EffectuerRole[]
  staff_de           RestaurantStaff[]
  commandes_passees  Command[]         @relation("ClientCommandes")
  livraisons_faites  Livraison[]       @relation("LivreurLivraisons")

  @@map("utilisateurs")
}

model Restaurant {
  id_restaurant Int      @id @default(autoincrement())
  nom           String
  adresse       String?
  telephone     String?
  latitude      Float?
  longitude     Float?

  staff            RestaurantStaff[]
  produits         Produit[]
  commandes_recues Command[]         @relation("RestaurantCommandes")

  @@map("restaurants")
}

model Produit {
  id_produit    Int    @id @default(autoincrement())
  nom           String
  prix          Float
  description   String?
  url_photo     String?
  prix_promo    Float?

  id_restaurant Int
  restaurant    Restaurant       @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)

  commandes DetailCommande[]

  @@map("produits")
}

model Commande {
  id_commande              Int    @id @default(autoincrement())
  date_commande            DateTime @default(now())
  statut                   String
  type_livraison           String?
  temps_preparation_estime_min Int?
  frais_livraison          Float    @default(0)

  id_client   Int
  client      Utilisateur @relation("ClientCommandes", fields: [id_client], references: [id_utilisateur], onDelete: Cascade)

  id_restaurant Int
  restaurant    Restaurant  @relation("RestaurantCommandes", fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)

  details   DetailCommande[]
  livraison Livraison?

  @@map("commandes")
}

model Livraison {
  id_livraison             Int       @id @default(autoincrement())
  statut_livraison         String
  note_livraison           String?
  heure_acceptation        DateTime?
  heure_recuperation       DateTime?
  heure_livraison_effective DateTime?

  id_commande Int       @unique
  commande    Commande  @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)

  id_livreur Int?
  livreur    Utilisateur? @relation("LivreurLivraisons", fields: [id_livreur], references: [id_utilisateur], onDelete: SetNull)

  @@map("livraisons")
}

model EffectuerRole {
  id_utilisateur Int
  id_role        Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  role           Role        @relation(fields: [id_role], references: [id_role], onDelete: Cascade)

  @@id([id_utilisateur, id_role])
  @@map("effectuer_roles")
}

model RestaurantStaff {
  id_utilisateur Int
  id_restaurant  Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  restaurant     Restaurant  @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)

  @@id([id_utilisateur, id_restaurant])
  @@map("restaurant_staffs")
}

model DetailCommande {
  id_detail_commande Int   @id @default(autoincrement())
  quantite           Int
  prix_unitaire      Float

  id_commande Int
  id_produit  Int
  commande    Commande @relation(fields: [id_commande], references: [id_commande], onDelete: Cascade)
  produit     Produit  @relation(fields: [id_produit], references: [id_produit], onDelete: Cascade)

  @@index([id_commande])
  @@index([id_produit])
  @@map("detail_commandes")
}
