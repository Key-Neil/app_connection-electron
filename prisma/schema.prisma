datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Utilisateur {
  id_utilisateur            Int     @id @default(autoincrement())
  nom                       String
  prenom                    String
  email                     String  @unique
  mot_de_passe_hash         String
  telephone                 String? @unique
  adresse_livraison_default String?
  disponibilite             String?
  position_lat              Float?
  position_lon              Float?

  utilisateur_roles UtilisateurRole[]
  comptes_commandes Commande[]        @relation("ClientCommandes")
  livraisons        Livraison[]
  staff_restaurants StaffRestaurant[]

  @@map("utilisateur")
}

model Role {
  id_role  Int    @id @default(autoincrement())
  nom_role String @unique

  utilisateur_roles UtilisateurRole[]

  @@map("role")
}

model UtilisateurRole {
  id_utilisateur Int
  id_role        Int

  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  role        Role        @relation(fields: [id_role], references: [id_role], onDelete: Cascade)

  @@id([id_utilisateur, id_role])
  @@map("utilisateur_role")
}

model Restaurant {
  id_restaurant Int     @id @default(autoincrement())
  nom           String
  adresse       String?
  telephone     String?
  latitude      Float?
  longitude     Float?

  produits          Produit[]
  sections          SectionMenu[]
  commandes         Commande[]
  staff_restaurants StaffRestaurant[]

  @@map("restaurant")
}

model StaffRestaurant {
  id_utilisateur Int
  id_restaurant  Int

  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  restaurant  Restaurant  @relation(fields: [id_restaurant], references: [id_restaurant], onDelete: Cascade)

  @@id([id_utilisateur, id_restaurant])
  @@map("staff_restaurant")
}

model SectionMenu {
  id_section  Int     @id @default(autoincrement())
  nom         String
  description String?
  ordre       Int     @default(0)

  id_restaurant Int
  restaurant    Restaurant @relation(fields: [id_restaurant], references: [id_restaurant])

  produits Produit[]

  @@map("section_menu")
}

model Produit {
  id_produit  Int     @id @default(autoincrement())
  nom         String
  prix        Float
  description String?
  url_photo   String?
  prix_promo  Float?

  id_restaurant Int
  restaurant    Restaurant @relation(fields: [id_restaurant], references: [id_restaurant])

  id_section Int
  section    SectionMenu @relation(fields: [id_section], references: [id_section])

  details_commande DetailCommande[] @relation("ProduitDetails")

  @@map("produit")
}

model Commande {
  id_commande                  Int      @id @default(autoincrement())
  date_commande                DateTime @default(now())
  statut                       String
  type_livraison               String?
  temps_preparation_estime_min Int?
  frais_livraison              Float?   @default(0)

  id_client Int
  client    Utilisateur @relation("ClientCommandes", fields: [id_client], references: [id_utilisateur])

  id_restaurant Int
  restaurant    Restaurant @relation(fields: [id_restaurant], references: [id_restaurant])

  livraison Livraison?

  details_commande DetailCommande[] @relation("CommandeDetails")

  @@map("commande")
}

model DetailCommande {
  id_detail_commande Int   @id @default(autoincrement())
  quantite           Int
  prix_unitaire      Float

  id_commande Int
  commande    Commande @relation("CommandeDetails", fields: [id_commande], references: [id_commande])

  id_produit Int
  produit    Produit @relation("ProduitDetails", fields: [id_produit], references: [id_produit])

  @@map("detail_commande")
}

model Livraison {
  id_livraison              Int       @id @default(autoincrement())
  statut_livraison          String    @default("En attente assignation") @db.VarChar(50)
  note_livraison            String?
  heure_acceptation         DateTime?
  heure_recuperation        DateTime?
  heure_livraison_effective DateTime?

  id_commande Int      @unique
  commande    Commande @relation(fields: [id_commande], references: [id_commande])

  id_livreur Int?
  livreur    Utilisateur? @relation(fields: [id_livreur], references: [id_utilisateur])

  @@map("livraison")
}
